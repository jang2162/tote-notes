    {
      "id": "tote.media-viewer",
      "version": "1.0.0",
      "displayName": "tote 미디어 뷰어",
      "source": "bundled",
      "enabled": true,
      "path": "/bundled/tote.media-viewer"
    },
    {
      "id": "tote.themes",
      "version": "1.0.0",
      "displayName": "tote 기본 테마",
      "source": "bundled",
      "enabled": true,
      "path": "/bundled/tote.themes"
    }
