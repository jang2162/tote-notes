{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tote",
  "version": "0.1.0",
  "identifier": "com.develma.totenotes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "media-src": "'none'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost tote-file:",
        "frame-src": "tote-ext:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERUM4MUJGN0QyOUFFNkYKUldSdnJpbDl2NEhzZlJRWTg2U0hFbU1FWTg3QXBxRU5od2JCb0pnK2lyTDZwaFAyOXFvMjIydTEK",
      "endpoints": ["https://github.com/jang2162/tote-notes/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "resources": {
      "resources/tote": "bin/tote",
      "resources/extensions": "extensions"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "text",
          "md",
          "markdown",
          "sh",
          "bash",
          "zsh",
          "command",
          "jsonc",
          "json5",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "conf",
          "env",
          "js",
          "mjs",
          "cjs",
          "jsx",
          "ts",
          "mts",
          "cts",
          "py",
          "pyi",
          "css",
          "xsl",
          "xslt",
          "sql",
          "go",
          "rs",
          "java",
          "c",
          "h",
          "cpp",
          "cc",
          "cxx",
          "hpp",
          "hh",
          "hxx",
          "diff",
          "patch",
          "dockerfile",
          "mk",
          "mak"
        ],
        "name": "Text Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [],
        "contentTypes": [
          "public.plain-text",
          "public.json",
          "public.xml",
          "public.svg-image",
          "public.html"
        ],
        "name": "Plain Text",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
