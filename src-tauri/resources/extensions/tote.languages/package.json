          ".bash",
          ".zsh",
          ".command"
        ],
        "filenames": [
          ".bashrc",
          ".zshrc",
          ".profile",
          ".bash_profile"
        ],
        "firstLine": "^#!.*\\b(bash|zsh|sh|ksh|dash)\\b",
        "configuration": "./language-configuration/shellscript.json"
