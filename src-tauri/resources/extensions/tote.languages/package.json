    "languages": [
      {
        "id": "plaintext",
        "aliases": [
          "Plain Text"
        ],
        "extensions": [
          ".txt",
          ".text"
        ],
        "filenames": [],
        "configuration": "./language-configuration/plaintext.json"
      },
